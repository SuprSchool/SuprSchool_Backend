NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Recording audio confirmation shells out to ffprobe. Leave this as `ffprobe` to
# use the system binary when one is installed; when it cannot be launched the
# server falls back to the packaged @ffprobe-installer/ffprobe binary, so no
# host install is required. Point it at an absolute path to pin a specific build.
#
# LICENSING: the packaged fallback ships GPL-3.0 binaries. The npm wrapper
# @ffprobe-installer/ffprobe is LGPL-2.1, but the per-platform binary it
# installs (@ffprobe-installer/win32-x64@5.1.0 and its siblings) is GPL-3.0.
# To drop the GPL-3.0 binary from the dependency tree entirely:
#   1. install a system ffmpeg/ffprobe
#   2. set FFPROBE_PATH to that binary's absolute path
#   3. npm uninstall @ffprobe-installer/ffprobe
# See docs/ffprobe.md for the full rationale and what changes at boot.
FFPROBE_PATH=ffprobe
REDIS_URL=redis://127.0.0.1:6379
